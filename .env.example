# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored -- never commit your real key.

# Required. Get one at https://aistudio.google.com
GEMINI_API_KEY=

# Optional. Model used by Scout and future agents (Strategist, Analyst).
# Run check_setup.py to see which models your key can call. If unset,
# defaults to a current Flash model.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Model used only by the Writer agent, since draft quality
# matters most there. Defaults to a pro-tier model even though GEMINI_MODEL
# defaults to Flash. If your key cannot call gemini-pro-latest, run
# check_setup.py and set this to a pro model that is available to you.
GEMINI_WRITER_MODEL=gemini-pro-latest
