# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored -- never commit your real key.

# Required. Get one at https://aistudio.google.com
GEMINI_API_KEY=

# Optional. Model used by Scout and future agents (Strategist, Analyst).
# Run check_setup.py to see which models your key can call. If unset,
# defaults to a current Flash model.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Model used only by the Writer agent, since draft quality
# matters most there. Defaults to a pro-tier model even though GEMINI_MODEL
# defaults to Flash. If your key cannot call gemini-2.5-pro, run
# check_setup.py and set this to a pro model that is available to you.
GEMINI_WRITER_MODEL=gemini-2.5-pro

# --- LinkedIn auto-posting (used by the Viral agent) ---
# The Viral agent can auto-post its LinkedIn post. It DEFAULTS TO DRY RUN:
# nothing is posted until you set LINKEDIN_DRY_RUN=false. Getting a token is a
# one-time manual step (LinkedIn developer app + "Share on LinkedIn" product +
# OAuth). See README.
# App credentials, used only by linkedin_auth.py to fetch a token. From your
# LinkedIn developer app (see LINKEDIN_SETUP.md). Not needed once you have a token.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URL" in your LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
# Filled in for you by:  python linkedin_auth.py
LINKEDIN_ACCESS_TOKEN=
# Who the post is authored as. For John (a member): urn:li:person:xxxx
LINKEDIN_ACTOR_URN=
# Leave true until you have a real token and want posts to go live.
LINKEDIN_DRY_RUN=true
# Optional. LinkedIn versioned-API month, YYYYMM. Defaults to a recent version.
LINKEDIN_API_VERSION=202405
